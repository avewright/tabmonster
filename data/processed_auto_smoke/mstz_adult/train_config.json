{
  "experiment_name": "finetune_mstz_adult",
  "seed": 42,
  "task": {
    "mode": "finetune",
    "problem_type": "multiclass",
    "target_column": "workclass"
  },
  "data": {
    "dataset_type": "prepared",
    "prepared_dir": "data\\processed_auto_smoke\\mstz_adult",
    "train_path": "data\\processed_auto_smoke\\mstz_adult\\train.csv",
    "val_path": "data\\processed_auto_smoke\\mstz_adult\\val.csv",
    "numeric_columns": [
      "age",
      "capital_gain",
      "capital_loss",
      "education",
      "final_weight",
      "hours_worked_per_week",
      "over_threshold",
      "capital_gain_log1p",
      "capital_loss_log1p",
      "final_weight_log1p",
      "native_country_frequency"
    ],
    "categorical_columns": [
      "marital_status",
      "native_country",
      "occupation",
      "race",
      "relationship",
      "is_male"
    ],
    "text_columns": [],
    "batch_size": 256,
    "num_workers": 0,
    "standardize_numeric": true
  },
  "model": {
    "d_model": 192,
    "n_heads": 6,
    "n_layers": 6,
    "d_ff": 384,
    "dropout": 0.1,
    "max_categories": 256
  },
  "training": {
    "device": "cpu",
    "max_epochs": 20,
    "lr": 0.0003,
    "weight_decay": 0.0001,
    "grad_clip_norm": 1.0,
    "log_interval": 20,
    "early_stopping_patience": 5
  }
}